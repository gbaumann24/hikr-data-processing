model ClimbingTourBaseSchema {
  reportId      BigInt @id @map("report_id")
  schemaVersion String @map("schema_version")
  routeId       BigInt @map("route_id")

  base                ReportBaseSchema                       @relation(fields: [reportId], references: [reportId], onDelete: Cascade)
  route               RouteSchema                            @relation(fields: [routeId], references: [id], onDelete: Restrict)
  ausruestung         ClimbingTourAusruestungSchema?
  zeitbedarf          ClimbingTourZeitbedarfSchema?
  absicherung         ClimbingTourAbsicherungSchema?
  schuhwerk           ClimbingTourSchuhwerkSchema?
  gelaendeUndGefahren ClimbingTourGelaendeUndGefahrenSchema?
  klettern            ClimbingTourKletternSchema?
  anreise             ClimbingTourAnreiseSchema?
  zustiegUndAbstieg   ClimbingTourZustiegUndAbstiegSchema?
  besonderes          ClimbingTourBesonderesSchema?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([routeId], map: "climbing_tour_base_schema_route_id_idx")
  @@map("climbing_tour_base_schema")
}

model ClimbingTourAusruestungSchema {
  baseId BigInt                 @id @map("base_id")
  base   ClimbingTourBaseSchema @relation(fields: [baseId], references: [reportId], onDelete: Cascade)

  seilArt                          String?  @map("seil_art")
  seilLaengeM                      Int?     @map("seil_laenge_m")
  mobileAbsicherungNotwendigkeit   Json     @default("[]") @map("mobile_absicherung_notwendigkeit")
  mobileAbsicherungBegruendung     String?  @map("mobile_absicherung_begruendung")
  mobileAbsicherungMoeglichkeiten  String?  @map("mobile_absicherung_moeglichkeiten")
  mobileAbsicherungFriends         Json     @default("[]") @map("mobile_absicherung_friends")
  mobileAbsicherungKeile           Json     @default("[]") @map("mobile_absicherung_keile")
  schlingen                        Json     @default("[]")
  expresskarabinerAnzahl           Int?     @map("expresskarabiner_anzahl")
  zusaetzlich                      Json     @default("[]")

  @@map("climbing_tour_ausruestung_schema")
}

model ClimbingTourZeitbedarfSchema {
  baseId BigInt                 @id @map("base_id")
  base   ClimbingTourBaseSchema @relation(fields: [baseId], references: [reportId], onDelete: Cascade)

  zustiegMin          Int? @map("zustieg_min")
  reineKletterzeitMin Int? @map("reine_kletterzeit_min")
  abstiegMin          Int? @map("abstieg_min")

  @@map("climbing_tour_zeitbedarf_schema")
}

model ClimbingTourAbsicherungSchema {
  baseId BigInt                 @id @map("base_id")
  base   ClimbingTourBaseSchema @relation(fields: [baseId], references: [reportId], onDelete: Cascade)

  charakter                  String?  @map("charakter")
  hakenabstaendeBewertung    String?  @map("hakenabstaende_bewertung")
  hakenabstaendeBeschreibung String?  @map("hakenabstaende_beschreibung")
  staendeGebohrt             Boolean? @map("staende_gebohrt")
  staendeBeschreibung        String?  @map("staende_beschreibung")
  hakenzustandBewertung      String?  @map("hakenzustand_bewertung")
  hakenzustandBeschreibung   String?  @map("hakenzustand_beschreibung")

  @@map("climbing_tour_absicherung_schema")
}

model ClimbingTourSchuhwerkSchema {
  baseId BigInt                 @id @map("base_id")
  base   ClimbingTourBaseSchema @relation(fields: [baseId], references: [reportId], onDelete: Cascade)

  zustiegTyp  String? @map("zustieg_typ")
  kletternTyp String? @map("klettern_typ")
  abstiegTyp  String? @map("abstieg_typ")

  @@map("climbing_tour_schuhwerk_schema")
}

model ClimbingTourGelaendeUndGefahrenSchema {
  baseId BigInt                 @id @map("base_id")
  base   ClimbingTourBaseSchema @relation(fields: [baseId], references: [reportId], onDelete: Cascade)

  charakterExposition       String?  @map("charakter_exposition")
  charakterSonnig           Boolean? @map("charakter_sonnig")
  charakterSchnellTrocknend Boolean? @map("charakter_schnell_trocknend")
  charakterFelsart          String?  @map("charakter_felsart")
  charakterBeschreibung     String?  @map("charakter_beschreibung")
  gefahren                  Json     @default("[]")

  @@map("climbing_tour_gelaende_und_gefahren_schema")
}

model ClimbingTourKletternSchema {
  baseId BigInt                 @id @map("base_id")
  base   ClimbingTourBaseSchema @relation(fields: [baseId], references: [reportId], onDelete: Cascade)

  schluesselstellenStellen          Json     @default("[]") @map("schluesselstellen_stellen")
  schwierigkeitVerhaeltnis          String?  @map("schwierigkeit_verhaeltnis")
  schwierigkeitBeschreibung         String?  @map("schwierigkeit_beschreibung")
  schwierigkeitMinKlettererfahrung  String?  @map("schwierigkeit_min_klettererfahrung")
  abseilenMoeglich                  Boolean? @map("abseilen_moeglich")
  abseilenAnzahl                    Int?     @map("abseilen_anzahl")
  abseilenLaengenM                  Json     @default("[]") @map("abseilen_laengen_m")
  abseilenZumEinstieg               Boolean? @map("abseilen_zum_einstieg")
  abseilenAbseilpiste               Boolean? @map("abseilen_abseilpiste")
  charakterKletterstil              Json     @default("[]") @map("charakter_kletterstil")
  charakterBeschreibung             String?  @map("charakter_beschreibung")
  charakterSchoenheit               String?  @map("charakter_schoenheit")
  charakterErnsthaftigkeit          String?  @map("charakter_ernsthaftigkeit")
  charakterWandhoehe                Int?     @map("charakter_wandhoehe")
  routenverlaufRoutenfindung        String?  @map("routenverlauf_routenfindung")
  routenverlaufBeschreibung         String?  @map("routenverlauf_beschreibung")
  routenverlaufRueckzugMoeglich     Boolean? @map("routenverlauf_rueckzug_moeglich")
  routenverlaufRueckzugBeschreibung String?  @map("routenverlauf_rueckzug_beschreibung")
  routenverlaufEinstiegshoehe       Int?     @map("routenverlauf_einstiegshoehe")
  seillaengenInfoAnzahlTotal        Int?     @map("seillaengen_info_anzahl_total")
  seillaengenVerbindenMoeglich      Boolean? @map("seillaengen_verbinden_moeglich")
  seillaengenVerbindenBeschreibung  String?  @map("seillaengen_verbinden_beschreibung")
  seillaengen                       Json     @default("[]")

  @@map("climbing_tour_klettern_schema")
}

model ClimbingTourAnreiseSchema {
  baseId BigInt                 @id @map("base_id")
  base   ClimbingTourBaseSchema @relation(fields: [baseId], references: [reportId], onDelete: Cascade)

  parkplatzOrt            String?  @map("parkplatz_ort")
  parkplatzKosten         String?  @map("parkplatz_kosten")
  parkplatzBesonderheiten String?  @map("parkplatz_besonderheiten")
  oevVerkehrsmittel       Json     @default("[]") @map("oev_verkehrsmittel")
  oevEndstation           String?  @map("oev_endstation")
  oevLuftseilbahnMoeglich Boolean? @map("oev_luftseilbahn_moeglich")
  oevAnmeldungNoetig      Boolean? @map("oev_anmeldung_noetig")
  vonPasshoeheAus         String?  @map("von_passhoehe_aus")

  @@map("climbing_tour_anreise_schema")
}

model ClimbingTourZustiegUndAbstiegSchema {
  baseId BigInt                 @id @map("base_id")
  base   ClimbingTourBaseSchema @relation(fields: [baseId], references: [reportId], onDelete: Cascade)

  zustiegEinstiegsfindung  String?  @map("zustieg_einstiegsfindung")
  zustiegBeschreibung      String?  @map("zustieg_beschreibung")
  zustiegSchwierigkeit     String?  @map("zustieg_schwierigkeit")
  zustiegHmAufstieg        Int?     @map("zustieg_hm_aufstieg")
  zustiegHmAbstieg         Int?     @map("zustieg_hm_abstieg")
  abstiegFuehrtZumEinstieg Boolean? @map("abstieg_fuehrt_zum_einstieg")
  abstiegSchwierigkeit     String?  @map("abstieg_schwierigkeit")
  abstiegHmAufstieg        Int?     @map("abstieg_hm_aufstieg")
  abstiegHmAbstieg         Int?     @map("abstieg_hm_abstieg")
  verpflegungTyp           String?  @map("verpflegung_typ")

  @@map("climbing_tour_zustieg_und_abstieg_schema")
}

model ClimbingTourBesonderesSchema {
  baseId BigInt                 @id @map("base_id")
  base   ClimbingTourBaseSchema @relation(fields: [baseId], references: [reportId], onDelete: Cascade)

  saisonalitaet Json?   @map("saisonalitaet")
  frequentierung String? @map("frequentierung")
  bedingungen    Json?   @map("bedingungen")
  hinweise       Json    @default("[]")

  @@map("climbing_tour_besonderes_schema")
}
